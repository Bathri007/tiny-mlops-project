{
  "version": 1,
  "author": "CDS 303 TinyMLOps",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 30,
      "left": 190,
      "attrs": { "color": "green", "label": "BIST PASS" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 110,
      "left": 150,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp:D2", "r1:1", "green", [ "h0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "serialMonitor": { "display": "terminal", "newline": "lf" },
  "dependencies": {}
}
